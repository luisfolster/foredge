{
  "name": "@foredge/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "contract:export": "node dist/export-openapi.js",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/migrate.ts",
    "key:create": "node --env-file-if-exists=../.env --import tsx src/key-cli.ts create",
    "key:revoke": "node --env-file-if-exists=../.env --import tsx src/key-cli.ts revoke",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9"
  }
}
